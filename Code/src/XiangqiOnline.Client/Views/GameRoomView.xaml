<UserControl x:Class="UDM18.Client.Views.GameRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UDM18.Client.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="⇅  Xoay bàn" Command="{Binding FlipBoardCommand}" Background="#475569"/>
            <StackPanel><TextBlock Text="Phòng đấu" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock Foreground="{StaticResource Muted}" Margin="0,4,0,0"><Run Text="Room "/><Run Text="{Binding RoomId, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold"/><Run Text="  ·  Revision "/><Run Text="{Binding Revision, Mode=OneWay}"/><Run Text="  ·  Lượt "/><Run Text="{Binding CurrentTurn, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="225"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14" Background="#E7D7B6">
                <Viewbox Stretch="Uniform">
                    <controls:BoardControl Width="400" Height="445" Pieces="{Binding Pieces}" Selected="{Binding Selected}" LastFrom="{Binding LastFrom}" LastTo="{Binding LastTo}" Orientation="{Binding Orientation}" CoordinateClickedCommand="{Binding CoordinateClickedCommand}"/>
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="TRẠNG THÁI TRẬN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="14" Foreground="{StaticResource Ink}"/></StackPanel>
                </Border>
                <Border Margin="0,18,0,0" Padding="18" CornerRadius="14" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1">
                    <StackPanel><TextBlock Text="Server authoritative" FontWeight="Bold" Foreground="#9A3412"/><TextBlock Text="Client chỉ gửi ý định. Board chỉ đổi sau MOVE_COMMITTED hoặc snapshot." TextWrapping="Wrap" Foreground="#9A3412" Margin="0,7,0,0"/></StackPanel>
                </Border>
                <Border Margin="0,18,0,0" Padding="18" CornerRadius="14" Background="#EFF6FF">
                    <StackPanel><TextBlock Text="Cách thao tác" FontWeight="Bold" Foreground="#1E40AF"/><TextBlock Text="1. Chọn ô nguồn&#x0a;2. Chọn ô đích&#x0a;3. Chờ Server xác nhận" Foreground="#1E40AF" LineHeight="24" Margin="0,7,0,0"/></StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="帥/將 Tướng   ·   仕/士 Sĩ   ·   相/象 Tượng   ·   馬 Mã   ·   車 Xe   ·   炮 Pháo   ·   兵/卒 Tốt" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
