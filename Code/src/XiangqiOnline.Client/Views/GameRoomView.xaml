<UserControl x:Class="UDM18.Client.Views.GameRoomView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:UDM18.Client.Controls" xmlns:converters="clr-namespace:UDM18.Client.Converters">
    <UserControl.Resources>
        <converters:GameAreaHeightConverter x:Key="GameAreaHeight" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{Binding OwnSideColor}" CornerRadius="12" Padding="13,8" Margin="0,0,10,0">
                    <TextBlock Text="{Binding OwnSideLabel}" Foreground="White" FontSize="10" FontWeight="Bold" />
                </Border>
                <Border Background="#E5DBCC" CornerRadius="12" Padding="12,8" Margin="0,0,10,0">
                    <TextBlock Foreground="#5F5145" FontSize="11">
                        <Run Text="REV " />
                        <Run Text="{Binding Revision, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                </Border>
                <Button Content="⇅  Xoay bàn" Command="{Binding FlipBoardCommand}" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="PHÒNG THI ĐẤU" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Bàn cờ trực tuyến" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />
                <TextBlock Foreground="{StaticResource Muted}" Margin="0,5,0,0">
                    <Run Text="Mã phòng  " />
                    <Run Text="{Binding RoomId, Mode=OneWay, TargetNullValue=Đang chờ...}" FontWeight="SemiBold" />
                    <Run Text="   ·   " />
                    <Run Text="{Binding ViewerLabel, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" MaxHeight="700" MinHeight="470" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource GameAreaHeight}, ConverterParameter=150}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="3*" MinWidth="270" />
            </Grid.ColumnDefinitions>
            <Border Background="#2A211A" CornerRadius="22" Padding="14" Margin="16,10" MaxWidth="650" HorizontalAlignment="Center" VerticalAlignment="Stretch" Effect="{StaticResource CardShadow}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCheckAlert}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-11" To="11" Duration="0:0:0.055" AutoReverse="True" RepeatBehavior="5x" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Border CornerRadius="16" BorderBrush="#594635" BorderThickness="1" Background="#17120F" />
                    <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="7">
                        <controls:BoardControl Width="720" Height="800" Pieces="{Binding Pieces}" Selected="{Binding Selected}" LastFrom="{Binding LastFrom}" LastTo="{Binding LastTo}" Orientation="{Binding Orientation}" UseClassicPieces="{Binding UseClassicPieces}" CoordinateClickedCommand="{Binding CoordinateClickedCommand}" />
                    </Viewbox>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#E6A11111" BorderBrush="#FFF0B45A" BorderThickness="2" CornerRadius="18" Padding="30,16" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCheckAlert}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.72" To="1" Duration="0:0:0.18" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.72" To="1" Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Image Source="{Binding CheckBannerImage}" Width="285" Stretch="Uniform" />
                        </StackPanel>
                    </Border>
                    <Border Background="#E826211D" BorderBrush="#D7A84D" BorderThickness="1" CornerRadius="22" Padding="34,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWaitingForOpponent}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#A61B1B" HorizontalAlignment="Center">
                                <TextBlock Text="帥" FontFamily="Microsoft YaHei" FontSize="29" Foreground="#FFF3DD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="ĐANG CHỜ ĐỐI THỦ" Foreground="#F5DCA7" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0" />
                            <TextBlock Text="Bàn cờ đã sẵn sàng. Ván đấu sẽ tự bắt đầu khi có người tham gia." Foreground="#E8DED1" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Width="285" Margin="0,7,0,0" />
                            <Border Background="#33FFFFFF" CornerRadius="9" Padding="12,7" HorizontalAlignment="Center" Margin="0,13,0,0">
                                <TextBlock Foreground="White" FontSize="11">
                                    <Run Text="MÃ PHÒNG  " />
                                    <Run Text="{Binding RoomId, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFFDF8" BorderBrush="#E6DAC8" BorderThickness="1" CornerRadius="18" Padding="15" Effect="{StaticResource SoftShadow}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RedClockStateText}" Foreground="#9A7567" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="ĐỎ" Foreground="{StaticResource Primary}" FontSize="10" FontWeight="Bold" />
                            </DockPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bên Đỏ" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding RedClockText}" Foreground="{StaticResource Primary}" FontFamily="Consolas" FontSize="24" FontWeight="Bold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#24201C" CornerRadius="18" Padding="15" Effect="{StaticResource SoftShadow}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding BlackClockStateText}" Foreground="#C7AA74" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="ĐEN" Foreground="#A99C90" FontSize="10" FontWeight="Bold" />
                            </DockPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bên Đen" Foreground="#FFF8EE" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding BlackClockText}" Foreground="#F2D18C" FontFamily="Consolas" FontSize="24" FontWeight="Bold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Margin="0,12,0,0" Background="#FFF7E8" BorderBrush="#D59A32" BorderThickness="1" CornerRadius="18" Padding="18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReplayMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="#8F1926" CornerRadius="10" Padding="10,5">
                                        <TextBlock Text="{Binding ReplayResult}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="📜  TRÌNH PHÁT LẠI" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding ReplayStepLabel}" Foreground="{StaticResource Ink}" FontSize="19" FontWeight="Bold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding ReplayMoveLabel}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="|◀ Đầu" Command="{Binding ReplayFirstCommand}" Style="{StaticResource SecondaryButton}" Padding="7,9" />
                                    <Button Grid.Column="2" Content="◀ Lùi" Command="{Binding ReplayPreviousCommand}" Style="{StaticResource SecondaryButton}" Padding="7,9" />
                                    <Button Grid.Column="4" Content="Tiến ▶" Command="{Binding ReplayNextCommand}" Style="{StaticResource SuccessButton}" Padding="7,9" />
                                    <Button Grid.Column="6" Content="Cuối ▶|" Command="{Binding ReplayLastCommand}" Style="{StaticResource SecondaryButton}" Padding="7,9" />
                                </Grid>
                                <Button Content="Trở về danh sách lịch sử" Command="{Binding ReturnToLobbyCommand}" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Padding="18">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReplayMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="ĐIỀU KHIỂN" Style="{StaticResource Eyebrow}" />
                                <CheckBox Content="Âm thanh trong trận" IsChecked="{Binding IsSoundEnabled}" Foreground="{StaticResource Ink}" Margin="0,10,0,0" />
                                <CheckBox Content="Bộ quân cổ điển VMU" IsChecked="{Binding UseClassicPieces}" Foreground="{StaticResource Ink}" Margin="0,7,0,0" />
                                <TextBlock Text="Nước đi được xác nhận bởi máy chủ trước khi bàn cờ thay đổi." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="17" Margin="0,8,0,15" />
                                <Button Content="Đề nghị hòa" Command="{Binding OfferDrawCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Chấp nhận hòa" Command="{Binding AcceptDrawCommand}" Style="{StaticResource SuccessButton}" />
                                    <Button Grid.Column="2" Content="Từ chối" Command="{Binding DeclineDrawCommand}" Style="{StaticResource SecondaryButton}" />
                                </Grid>
                                <Button Content="Đầu hàng" Command="{Binding ResignCommand}" Style="{StaticResource DangerButton}" />
                                <Border Background="#FFF2D9" BorderBrush="#D99A2B" BorderThickness="1" CornerRadius="13" Padding="13" Margin="0,10,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIncomingRematchOffer}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="⚔ ĐỐI THỦ MUỐN ĐẤU LẠI" Foreground="#9B1C1C" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Text="Bạn có đồng ý mở ván mới và đổi màu quân không?" TextWrapping="Wrap" Foreground="{StaticResource Ink}" FontSize="11" Margin="0,5,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Chấp nhận" Command="{Binding AcceptRematchCommand}" Style="{StaticResource SuccessButton}" />
                                            <Button Grid.Column="2" Content="Từ chối" Command="{Binding DeclineRematchCommand}" Style="{StaticResource SecondaryButton}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Button Content="⚔ Yêu cầu đấu lại" Command="{Binding RequestRematchCommand}" Margin="0,10,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsGameEnded}" Value="True" />
                                                        <Condition Binding="{Binding IsSpectator}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Border Background="#E8F3EC" CornerRadius="10" Padding="11,8" Margin="0,8,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRematchPending}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="⌛ Đang chờ đối thủ phản hồi yêu cầu đấu lại..." Foreground="#286446" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Border>
                                <Button Content="Hủy phòng và về sảnh" Command="{Binding CancelWaitingRoomCommand}" Margin="0,8,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWaitingForOpponent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Rời phòng khán giả" Command="{Binding LeaveSpectatorCommand}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" />
                                <Button Content="Trở về sảnh" Command="{Binding ReturnToLobbyCommand}" Margin="0,8,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameEnded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Background="#FFF9F0" BorderBrush="#E4C99B" BorderThickness="1" CornerRadius="18" Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border DockPanel.Dock="Right" Background="#F3E1BD" CornerRadius="9" Padding="8,4">
                                        <TextBlock Text="AN TOÀN · CHỐNG SPAM" Foreground="#80551A" FontSize="8" FontWeight="Bold" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="TRÒ CHUYỆN NHANH 💬" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="Gửi lời vui vẻ bằng emoji" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding ChatMessages}" MaxHeight="130" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F5E9D8" CornerRadius="10" Padding="9,7" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding SenderLabel}" Foreground="{StaticResource Primary}" FontSize="9" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource Ink}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="{StaticResource Muted}" FontSize="8" Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Margin="0,7,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" MinHeight="40" Padding="10,8" ToolTip="Nhập tin nhắn tối đa 200 ký tự" />
                                    <Button Grid.Column="2" Content="Gửi  ➤" Command="{Binding SendChatCommand}" Padding="16,9" />
                                </Grid>
                                <TextBlock Text="EMOTE ĐẤU TRÍ" Foreground="{StaticResource Primary}" FontSize="10" FontWeight="Bold" Margin="2,7,0,2" />
                                <UniformGrid Columns="2" Margin="-4,3,-4,0">
                                    <Button Command="{Binding SendQuickChatCommand}" CommandParameter="HELLO" Style="{StaticResource SecondaryButton}" Height="48" Padding="8,6" Margin="4">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="👋" FontSize="24" />
                                            <TextBlock Text="Chào bạn" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SendQuickChatCommand}" CommandParameter="GOOD_MOVE" Style="{StaticResource SecondaryButton}" Height="48" Padding="8,6" Margin="4">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="👏" FontSize="24" />
                                            <TextBlock Text="Nước hay" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SendQuickChatCommand}" CommandParameter="THANKS" Style="{StaticResource SecondaryButton}" Height="48" Padding="8,6" Margin="4">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🙏" FontSize="24" />
                                            <TextBlock Text="Cảm ơn" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SendQuickChatCommand}" CommandParameter="THINKING" Style="{StaticResource SecondaryButton}" Height="48" Padding="8,6" Margin="4">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🤔" FontSize="24" />
                                            <TextBlock Text="Đang tính..." Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SendQuickChatCommand}" CommandParameter="CHALLENGE" Style="{StaticResource DangerButton}" Height="48" Padding="8,6" Margin="4">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🔥" FontSize="24" />
                                            <TextBlock Text="Tới công chuyện!" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SendQuickChatCommand}" CommandParameter="CHECK" Style="{StaticResource DangerButton}" Height="48" Padding="8,6" Margin="4">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⚔️" FontSize="24" />
                                            <TextBlock Text="Cẩn thận chiếu!" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SendQuickChatCommand}" CommandParameter="PRESSURE" Style="{StaticResource SecondaryButton}" Height="48" Padding="8,6" Margin="4">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="😎" FontSize="24" />
                                            <TextBlock Text="Áp lực chưa?" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SendQuickChatCommand}" CommandParameter="COMEBACK" Style="{StaticResource SecondaryButton}" Height="48" Padding="8,6" Margin="4">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🐉" FontSize="24" />
                                            <TextBlock Text="Sẽ lật kèo!" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Background="#F8EEE5" BorderBrush="#E6CCB6" BorderThickness="1" CornerRadius="18" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" Background="#F1D9C7">
                                    <TextBlock Text="1" Foreground="{StaticResource Primary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                    <TextBlock Text="Chạm quân muốn đi" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="Sau đó chọn giao điểm đích." Foreground="{StaticResource Muted}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>