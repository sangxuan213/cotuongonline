<UserControl x:Class="UDM18.Client.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Content="↻  Làm mới" Command="{Binding RefreshCommand}"/>
            <StackPanel><TextBlock Text="Sảnh đấu" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock Text="Chọn một người đang rảnh để gửi lời thách đấu." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14"><TextBlock Text="NGƯỜI CHƠI TRỰC TUYẾN" FontWeight="Bold" Foreground="{StaticResource Muted}" FontSize="11"/><Border DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="9" Padding="9,4"><TextBlock Text="Server live" Foreground="#15803D" FontSize="11" FontWeight="SemiBold"/></Border></DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="#DBEAFE"><TextBlock Text="{Binding Initial}" Foreground="#1D4ED8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="ID người chơi" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel><Border Grid.Column="2" Background="#ECFDF5" CornerRadius="9" Padding="9,4" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="#047857" FontSize="11"/></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Content="Gửi lời thách đấu" Command="{Binding ChallengeCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="LỜI MỜI ĐẾN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding IncomingChallenge.FromDisplayName, TargetNullValue=Chưa có lời mời mới}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,12,0,18" TextWrapping="Wrap"/><WrapPanel><Button Content="Chấp nhận" Command="{Binding AcceptCommand}" Background="#0F766E"/><Button Content="Từ chối" Command="{Binding RejectCommand}" Background="#B91C1C"/></WrapPanel></StackPanel>
                </Border>
                <Border Margin="0,18,0,0" Padding="18" CornerRadius="14" Background="#EFF6FF"><TextBlock Text="Một lời mời chỉ tạo phòng sau khi Server xác nhận CHALLENGE_ACCEPT và phát ROOM_CREATED." TextWrapping="Wrap" Foreground="#1E40AF"/></Border>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12" Background="#E8EEF5" CornerRadius="9"><TextBlock Text="{Binding Status}" Foreground="#475569" TextWrapping="Wrap"/></Border>
    </Grid>
</UserControl>
