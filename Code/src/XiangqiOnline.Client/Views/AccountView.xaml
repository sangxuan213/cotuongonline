<UserControl x:Class="UDM18.Client.Views.AccountView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:UDM18.Client.Behaviors">
    <UserControl.Resources>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#FFFCF7" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="AccountLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,12,0,6" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.92*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.08*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource HeroGradient}" CornerRadius="24" Effect="{StaticResource CardShadow}" ClipToBounds="True">
            <Grid>
                <Ellipse Width="430" Height="430" Fill="#12FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-190,-210,0" />
                <Ellipse Width="260" Height="260" Stroke="#20FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-130,0,0,-100" />
                <StackPanel Margin="42" VerticalAlignment="Center">
                    <Border Width="82" Height="82" CornerRadius="41" Background="#FFF4DB" HorizontalAlignment="Left">
                        <TextBlock Text="棋" FontFamily="Microsoft YaHei" FontSize="43" FontWeight="Bold" Foreground="#981B1B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Chào mừng kỳ thủ&#xA;trở lại bàn cờ." Foreground="#FFF7E9" FontSize="38" FontWeight="SemiBold" LineHeight="47" Margin="0,30,0,0" />
                    <TextBlock Text="Một tài khoản để thi đấu cùng bạn bè, lưu lịch sử và khôi phục mọi ván cờ." Foreground="#F4CFC7" TextWrapping="Wrap" FontSize="15" LineHeight="24" Margin="0,16,28,0" />
                    <StackPanel Margin="0,30,0,0">
                        <TextBlock Text="✓  Mật khẩu được băm an toàn" Foreground="#FFF4E6" Margin="0,0,0,13" />
                        <TextBlock Text="✓  Mã khôi phục chỉ dùng một lần" Foreground="#FFF4E6" Margin="0,0,0,13" />
                        <TextBlock Text="✓  Không làm lộ email đã đăng ký" Foreground="#FFF4E6" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="32,26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="TÀI KHOẢN NHÓM 6" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Đăng nhập tài khoản" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,6,0,4" />
                    <TextBlock Text="Đăng nhập hoặc tạo tài khoản mới hoàn toàn miễn phí." Foreground="{StaticResource Muted}" />
                </StackPanel>
                <TabControl Grid.Row="1" Margin="0,22,0,10" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Đăng nhập">
                        <StackPanel Margin="2,16,2,0">
                            <TextBlock Text="Địa chỉ email" Style="{StaticResource AccountLabel}" />
                            <TextBox Text="{Binding Connection.Email, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Mật khẩu" Style="{StaticResource AccountLabel}" />
                            <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding Connection.Password, Mode=TwoWay}" />
                            <Button Content="Đăng nhập và vào sảnh  →" Command="{Binding Connection.AccountLoginCommand}" Margin="0,20,0,0" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Đăng ký">
                        <StackPanel Margin="2,16,2,0">
                            <TextBlock Text="Địa chỉ email" Style="{StaticResource AccountLabel}" />
                            <TextBox Text="{Binding Connection.Email, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Tên hiển thị" Style="{StaticResource AccountLabel}" />
                            <TextBox Text="{Binding Connection.DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mật khẩu" Style="{StaticResource AccountLabel}" />
                                    <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding Connection.Password, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Nhập lại" Style="{StaticResource AccountLabel}" />
                                    <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding Connection.ConfirmPassword, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Mật khẩu từ 8 đến 128 ký tự." Foreground="{StaticResource Muted}" FontSize="11" Margin="2,7,0,0" />
                            <Button Content="Tạo tài khoản và vào sảnh  →" Command="{Binding Connection.RegisterCommand}" Margin="0,16,0,0" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Quên mật khẩu">
                        <StackPanel Margin="2,16,2,0">
                            <TextBlock Text="Email tài khoản" Style="{StaticResource AccountLabel}" />
                            <TextBox Text="{Binding Connection.Email, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Gửi mã 6 số về email" Command="{Binding Connection.RequestResetCommand}" Style="{StaticResource SecondaryButton}" Margin="0,12,0,2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.25*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mã xác nhận" Style="{StaticResource AccountLabel}" />
                                    <TextBox Text="{Binding Connection.ResetCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mật khẩu mới" Style="{StaticResource AccountLabel}" />
                                    <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding Connection.NewPassword, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Đặt lại mật khẩu" Command="{Binding Connection.ConfirmResetCommand}" Margin="0,16,0,0" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
                <StackPanel Grid.Row="2">
                    <Border Background="#E8F3EC" BorderBrush="#B9DDC9" BorderThickness="1" CornerRadius="10" Padding="12">
                        <TextBlock Text="{Binding Connection.Notice, TargetNullValue=Sẵn sàng xác thực an toàn.}" Foreground="#226448" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding Connection.Error}" Foreground="#A61B1B" FontWeight="SemiBold" TextWrapping="Wrap" Margin="3,8,3,0" />
                    <TextBlock Text="{Binding Connection.Status}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="11" Margin="0,5,2,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>