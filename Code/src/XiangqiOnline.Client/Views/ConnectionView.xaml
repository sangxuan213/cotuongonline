<UserControl x:Class="UDM18.Client.Views.ConnectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="KẾT NỐI NÂNG CAO" Style="{StaticResource Eyebrow}"/><TextBlock Text="Chơi nhanh bằng tên khách" Style="{StaticResource PageTitle}" Margin="0,4,0,0"/><TextBlock Text="Dùng khi kết nối máy chủ LAN/hosting khác hoặc không muốn tạo tài khoản." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><StackPanel VerticalAlignment="Center"><TextBlock Text="THÔNG TIN MÁY CHỦ" Style="{StaticResource Eyebrow}"/><TextBlock Text="Vào sảnh với tư cách khách" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,7,0,18"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Địa chỉ máy chủ" FontWeight="SemiBold" Margin="2,0,0,7"/><TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Cổng" FontWeight="SemiBold" Margin="2,0,0,7"/><TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
    <TextBlock Text="Tên khách" FontWeight="SemiBold" Margin="2,18,0,7"/><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="24"/>
    <Border Style="{StaticResource InsetCard}" Margin="0,18,0,0"><TextBlock Text="Tên khách chỉ tồn tại trong phiên hiện tại. Hãy dùng trang Tài khoản nếu muốn lưu danh tính và khôi phục mật khẩu." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Border>
    <Button Content="Kết nối và vào sảnh  →" Command="{Binding ConnectCommand}" Margin="0,20,0,0"/><TextBlock Text="{Binding Error}" Foreground="#A61B1B" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,10,2,0"/>
   </StackPanel></Border>
   <Border Grid.Column="2" Background="{StaticResource HeroGradient}" CornerRadius="22" Effect="{StaticResource CardShadow}"><StackPanel Margin="32" VerticalAlignment="Center"><TextBlock Text="◎" Foreground="#F4D38C" FontSize="54"/><TextBlock Text="LAN · Hosting&#x0a;Máy chủ riêng" Foreground="#FFF7E9" FontSize="31" FontWeight="SemiBold" LineHeight="39" Margin="0,17,0,0"/><TextBlock Text="Thay IP bằng địa chỉ máy chủ của nhóm. Cổng mặc định là 5000." Foreground="#F4CFC7" TextWrapping="Wrap" FontSize="14" LineHeight="22" Margin="0,14,0,0"/><Border Background="#22FFFFFF" CornerRadius="12" Padding="14" Margin="0,25,0,0"><StackPanel><TextBlock Text="TRẠNG THÁI" Foreground="#F4D38C" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Button Content="Kết nối lại" Command="{Binding ReconnectCommand}" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0"/></StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>
